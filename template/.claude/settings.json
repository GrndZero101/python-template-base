{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv tool:*)",
      "Bash(uv lock:*)",
      "Bash(ruff:*)",
      "Bash(ty:*)",
      "Bash(rumdl:*)",
      "Bash(prek:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(uv run *)",
      "PowerShell(uv add *)",
      "PowerShell(uv sync *)",
      "PowerShell(uv tool *)",
      "PowerShell(uv lock *)",
      "PowerShell(ruff *)",
      "PowerShell(ty *)",
      "PowerShell(rumdl *)",
      "PowerShell(prek *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "tools/session_doctor.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "tools/branch_guard.py",
              "--protected",
              "main",
              "master"
            ],
            "timeout": 15,
            "statusMessage": "Checking branch..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "tools/gate.py"
            ],
            "timeout": 120,
            "statusMessage": "Formatting and checking..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "tools/stop_gate.py"
            ],
            "timeout": 300,
            "statusMessage": "Checking the changed files before stopping..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": false
  }
}
